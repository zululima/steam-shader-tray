"""Tray icon that shows when Steam processes shaders, or has shader work left."""
import json
import os
import re
import signal
import sys

import gi

gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, Gio, GLib  # noqa: E402

STEAM = os.path.expanduser("~/.local/share/Steam")
LOG = os.path.join(STEAM, "logs/shader_log.txt")
OLD_LOG = os.path.join(STEAM, "logs/shader_log.previous.txt")
STATE = os.path.join(GLib.get_user_state_dir(), "steam-shader-tray/state.json")
PAUSE_LIST = os.path.join(GLib.get_user_config_dir(), "steam-shader-tray/pause-during")
ICON_DIRS = (
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "icons"),
    os.path.join(GLib.get_user_data_dir(), "steam-shader-tray/icons"),
)
PATH = "/StatusNotifierItem"
IFACE = "org.kde.StatusNotifierItem"
XML = """<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/>
<property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/>
<property name="Status" type="s" access="read"/>
<property name="IconName" type="s" access="read"/>
<property name="IconPixmap" type="a(iiay)" access="read"/>
<property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<property name="ItemIsMenu" type="b" access="read"/>
<method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
<signal name="NewTitle"/><signal name="NewIcon"/><signal name="NewToolTip"/>
<signal name="NewStatus"><arg type="s"/></signal>
</interface></node>"""
INFO = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
NOTIFICATIONS = "org.freedesktop.Notifications"

LINE = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] (.*)$")
PROGRESS = re.compile(r"Still replaying (\d+) \((\d+)%, (\d+)/(\d+)\)")
NEW_DATA = re.compile(r"Committed bucket \d+ \(AppID (\d+)\) from (\d+) to (\d+)\.")
STARTED = re.compile(r"Starting replay of FOZ databases for AppID (\d+)")
COMPLETED = re.compile(r"\[ App ID (\d+) \] fossilize_replay completed")


class Tray:
    def __init__(self, conn):
        self.conn = conn
        self.item = None
        self.names = {}
        self.pixmaps = {name: load_pixmaps(find_icon(name)) for name in ("busy", "paused")}
        self.done_icon = find_icon("idle")
        self.view = {"status": "Passive", "icon": "idle", "title": "", "text": ""}
        self.shown = set()
        self.finished = []
        self.notes = set()
        self.ready = False
        self.saved = self.load_state()
        self.apps = self.saved.get("apps", {})
        self.last = self.saved.get("last", "")
        self.log = None
        self.pending = ""
        self.stopped = stopped_pids(scan_processes()[0])
        try:
            with open(OLD_LOG, "rb") as f:
                self.feed(f.read())
        except OSError:
            pass
        self.reopen()
        if self.log:
            self.feed(self.log.read())
        self.ready = True

    def load_state(self):
        try:
            with open(STATE) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_state(self):
        data = {"last": self.last, "apps": self.apps}
        if data != self.saved:
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            with open(STATE + ".tmp", "w") as f:
                json.dump(data, f, indent=1)
            os.replace(STATE + ".tmp", STATE)
            self.saved = json.loads(json.dumps(data))

    def reopen(self):
        if self.log:
            self.log.close()
        try:
            self.log = open(LOG, "rb")
        except OSError:
            self.log = None
        self.pending = ""
        self.stopped = stopped_pids(scan_processes()[0])

    def read_new_lines(self):
        if self.log is None:
            self.reopen()
            if self.log is None:
                return
        self.feed(self.log.read())
        try:
            rotated = os.stat(LOG).st_ino != os.fstat(self.log.fileno()).st_ino
            shrunk = os.path.getsize(LOG) < self.log.tell()
        except OSError:
            return
        if rotated or shrunk:
            if rotated:
                self.feed(self.log.read())
            self.reopen()
            if self.log:
                self.feed(self.log.read())

    def feed(self, data):
        lines = (self.pending + data.decode(errors="replace")).split("\n")
        self.pending = lines.pop()
        for line in lines:
            m = LINE.match(line)
            if not m or m.group(1) < self.last:
                continue
            self.last, message = m.groups()
            self.apply(self.last, message)

    def apply(self, when, message):
        # A pass Steam stops, as when a game starts or Play is pressed, ends
        # in a kill and not a completion, so an app stays unfinished from new
        # shader data or a started pass until a pass completes.
        m = PROGRESS.search(message)
        if m:
            app = self.apps.setdefault(m.group(1), {"state": "unfinished"})
            app["progress"] = [int(x) for x in m.groups()[1:]]
            app["at"] = when
            return
        m = NEW_DATA.search(message)
        if m and m.group(2) != m.group(3):
            self.apps[m.group(1)] = {"state": "unfinished", "at": when}
            return
        m = STARTED.search(message)
        if m:
            app = self.apps.setdefault(m.group(1), {})
            app["state"] = "unfinished"
            return
        m = COMPLETED.search(message)
        if m:
            if self.ready and m.group(1) in self.shown:
                self.finished.append(m.group(1))
            self.apps[m.group(1)] = {"state": "done", "at": when}

    def app_name(self, appid):
        if appid not in self.names:
            self.names[appid] = None
            try:
                with open(os.path.join(STEAM, "steamapps/libraryfolders.vdf")) as f:
                    libraries = re.findall(r'"path"\s+"([^"]+)"', f.read())
            except OSError:
                libraries = [STEAM]
            for library in libraries:
                try:
                    with open(f"{library}/steamapps/appmanifest_{appid}.acf") as f:
                        m = re.search(r'"name"\s+"([^"]+)"', f.read())
                except OSError:
                    continue
                if m:
                    self.names[appid] = m.group(1)
                    break
        return self.names[appid]

    def describe(self, appid):
        progress = self.apps.get(appid, {}).get("progress")
        name = self.app_name(appid) or f"App {appid}"
        if not progress:
            return name
        return f"{name}: {progress[0]}%, {progress[1]}/{progress[2]}"

    def hold(self, replays, pausing):
        if pausing:
            for pid in replays.keys() - self.stopped:
                send(pid, signal.SIGSTOP)
            self.stopped = set(replays)
        else:
            for pid in self.stopped & replays.keys():
                send(pid, signal.SIGCONT)
            self.stopped = set()

    def release(self):
        self.hold(scan_processes()[0], False)

    def refresh(self):
        self.read_new_lines()
        self.save_state()
        replays, games = scan_processes()
        pausers = sorted(games & read_pause_list())
        self.hold(replays, bool(pausers))
        running = {appid for appid in replays.values() if appid}
        left = sorted(
            appid
            for appid, app in self.apps.items()
            if app.get("state") == "unfinished"
            and appid not in running
            and self.app_name(appid)
        )
        if running:
            lines = [self.describe(appid) for appid in sorted(running)]
            if left:
                lines.append("Also not finished: " + ", ".join(map(self.app_name, left)))
            if pausers:
                names = ", ".join(self.app_name(appid) or f"App {appid}" for appid in pausers)
                view = {
                    "status": "Active",
                    "icon": "paused",
                    "title": "Shader processing paused",
                    "text": "\n".join(lines) + f"\nPaused while {names} runs.",
                }
            else:
                view = {
                    "status": "Active",
                    "icon": "busy",
                    "title": "Steam is processing shaders",
                    "text": "\n".join(lines) + "\nWait before pressing Play.",
                }
        elif left:
            view = {
                "status": "Active",
                "icon": "paused",
                "title": "Shader processing not finished",
                "text": "\n".join(self.describe(appid) for appid in left)
                + "\nSteam is not processing shaders now. Play processes what is left first.",
            }
        else:
            view = {
                "status": "Passive",
                "icon": "idle",
                "title": "Shaders processed",
                "text": "No game has shader processing left.",
            }
        self.shown = running | set(left)
        if self.finished:
            self.notify_done(self.finished)
            self.finished = []
        if view != self.view:
            self.view = view
            if view["icon"] == "idle":
                self.hide_item()
            elif self.item is None:
                self.show_item()
            else:
                for name in ("NewIcon", "NewTitle", "NewToolTip"):
                    self.item.emit_signal(None, PATH, IFACE, name, None)
                self.item.emit_signal(
                    None, PATH, IFACE, "NewStatus", GLib.Variant("(s)", (view["status"],))
                )
        return True

    def show_item(self):
        # The item gets a bus connection of its own, closed when nothing is
        # left, since Plasma lists even a Passive item among its hidden icons.
        address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
        self.item = Gio.DBusConnection.new_for_address_sync(
            address,
            Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
            | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
            None, None,
        )
        self.item.register_object(PATH, INFO, lambda *args: args[-1].return_value(None),
                                  self.get_property, None)
        self.register()

    def hide_item(self):
        if self.item:
            self.item.close_sync(None)
            self.item = None

    def register(self):
        if self.item:
            self.item.call(
                "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
                GLib.Variant("(s)", (self.item.get_unique_name(),)),
                None, Gio.DBusCallFlags.NONE, -1, None, None,
            )

    def notify_done(self, appids):
        names = [self.app_name(appid) or f"App {appid}" for appid in appids]
        verb = "is" if len(names) == 1 else "are"
        self.conn.call(
            NOTIFICATIONS, "/org/freedesktop/Notifications", NOTIFICATIONS, "Notify",
            GLib.Variant("(susssasa{sv}i)", (
                "Steam shader tray", 0, self.done_icon, "Shaders processed",
                f"{', '.join(names)} {verb} ready to play.",
                ["default", "Open Steam"], {}, -1,
            )),
            GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1, None, self.noted,
        )

    def noted(self, conn, result):
        try:
            self.notes.add(conn.call_finish(result).unpack()[0])
        except GLib.Error:
            pass

    def clicked(self, conn, sender, path, iface, signal_name, params):
        note, action = params.unpack()
        if note in self.notes and action == "default":
            GLib.spawn_async(["steam", "steam://open/games"], flags=GLib.SpawnFlags.SEARCH_PATH)

    def get_property(self, conn, sender, path, iface, prop):
        pixmaps = self.pixmaps[self.view["icon"]]
        values = {
            "Category": GLib.Variant("s", "SystemServices"),
            "Id": GLib.Variant("s", "steam-shader-tray"),
            "Title": GLib.Variant("s", self.view["title"]),
            "Status": GLib.Variant("s", self.view["status"]),
            "IconName": GLib.Variant("s", ""),
            "IconPixmap": GLib.Variant("a(iiay)", pixmaps),
            "ItemIsMenu": GLib.Variant("b", False),
            "ToolTip": GLib.Variant(
                "(sa(iiay)ss)", ("", pixmaps, self.view["title"], self.view["text"])
            ),
        }
        return values[prop]


def find_icon(name):
    for folder in ICON_DIRS:
        svg = os.path.join(folder, f"steam-shader-tray-{name}.svg")
        if os.path.exists(svg):
            return svg
    sys.exit(f"steam-shader-tray: icon steam-shader-tray-{name}.svg not found")


def load_pixmaps(svg):
    # Pixmaps, not an icon name: Plasma trims an icon name it cannot find at
    # its dashes, and showed the "steam" icon for steam-shader-tray-busy.
    pixmaps = []
    for size in (16, 22, 24, 32, 48, 64):
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(svg, size, size)
        if not pixbuf.get_has_alpha():
            pixbuf = pixbuf.add_alpha(False, 0, 0, 0)
        width, height = pixbuf.get_width(), pixbuf.get_height()
        stride, pixels = pixbuf.get_rowstride(), pixbuf.get_pixels()
        rgba = b"".join(pixels[row * stride : row * stride + width * 4] for row in range(height))
        argb = bytearray(len(rgba))
        argb[0::4], argb[1::4] = rgba[3::4], rgba[0::4]
        argb[2::4], argb[3::4] = rgba[1::4], rgba[2::4]
        pixmaps.append((width, height, bytes(argb)))
    return pixmaps


def scan_processes():
    """Steam's shader passes as {pid: app ID or None}, and the app IDs of running games."""
    replays, games = {}, set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        if args[0].endswith(b"fossilize_replay"):
            m = re.search(rb"shadercache/(\d+)/", b" ".join(args))
            replays[int(pid)] = m.group(1).decode() if m else None
        elif args[0].endswith(b"reaper") and b"SteamLaunch" in args:
            for arg in args:
                if arg.startswith(b"AppId="):
                    games.add(arg[6:].decode())
                    break
    return replays, games


def stopped_pids(pids):
    # Passes a killed tray left stopped, continued at the first refresh.
    stopped = set()
    for pid in pids:
        try:
            with open(f"/proc/{pid}/stat") as f:
                if f.read().rsplit(")", 1)[1].split()[0] == "T":
                    stopped.add(pid)
        except (OSError, IndexError):
            pass
    return stopped


def read_pause_list():
    try:
        with open(PAUSE_LIST) as f:
            return {m.group(1) for m in map(re.compile(r"\s*(\d+)").match, f) if m}
    except OSError:
        return set()


def send(pid, sig):
    try:
        os.kill(pid, sig)
    except OSError:
        pass


def main():
    conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    reply = conn.call_sync(
        "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
        "RequestName", GLib.Variant("(su)", ("local.SteamShaderTray", 4)),
        None, Gio.DBusCallFlags.NONE, -1, None,
    )
    if reply.unpack()[0] != 1:
        sys.exit("steam-shader-tray is already running")
    tray = Tray(conn)
    conn.signal_subscribe(NOTIFICATIONS, NOTIFICATIONS, "ActionInvoked",
                          "/org/freedesktop/Notifications", None,
                          Gio.DBusSignalFlags.NONE, tray.clicked)
    tray.refresh()
    Gio.bus_watch_name_on_connection(
        conn, "org.kde.StatusNotifierWatcher", Gio.BusNameWatcherFlags.NONE,
        lambda *_: tray.register(), None,
    )
    GLib.timeout_add_seconds(5, tray.refresh)
    loop = GLib.MainLoop()

    def quit():
        tray.release()
        loop.quit()
        return False

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, quit)
    loop.run()


if __name__ == "__main__":
    main()
